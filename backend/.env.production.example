# =============================================================================
# SMART STUDY PORTAL — BACKEND ENVIRONMENT VARIABLES (RAILWAY / PRODUCTION)
# =============================================================================
# Target Service: Spring Boot REST API
# Base Image: Eclipse Temurin JRE 21 Alpine
# =============================================================================

# Server Port (Injected automatically by Railway, default: 8080)
PORT=8080

# -----------------------------------------------------------------------------
# 1. Database Connection (Railway MySQL Plugin or Managed MySQL 8.0)
# -----------------------------------------------------------------------------
# In Railway: If using the MySQL plugin, use ${{MySQL.DATABASE_URL}} or separate vars:
SPRING_DATASOURCE_URL=jdbc:mysql://mysql.railway.internal:3306/smart_study?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=smart_study
SPRING_DATASOURCE_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_MIN_24_CHARS

# -----------------------------------------------------------------------------
# 2. Security & Cross-Origin Settings
# -----------------------------------------------------------------------------
# High-entropy JWT signing key (at least 64 hex characters or 32 random bytes)
JWT_SECRET=GENERATE_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_64_CHARS

# Enable secure HTTP-only cookies in production (SameSite=None, Secure=true)
COOKIE_SECURE=true

# Allowed Frontend Origins (Comma-separated, e.g. Vercel production + preview domains)
WEB_ORIGIN=https://smart-study-portal.vercel.app,https://smart-study-frontend.vercel.app

# -----------------------------------------------------------------------------
# 3. Microservice Internal Networking
# -----------------------------------------------------------------------------
# Private internal URL to the FastAPI ML Engine service on Railway
# Use Railway private networking: http://<ml-service-name>.railway.internal:8000
ML_SERVICE_URL=http://ml.railway.internal:8000
ML_INTERNAL_TOKEN=GENERATE_SECURE_INTERNAL_CLUSTER_TOKEN_MIN_32_CHARS

# -----------------------------------------------------------------------------
# 4. Storage Configuration
# -----------------------------------------------------------------------------
# Storage backend: 'local' (Railway persistent volume) or 's3' (S3 / R2 / MinIO)
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads

# S3 Configuration (Only required if STORAGE_BACKEND=s3)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=smart-study-documents
# S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# Storage Quotas
MAX_UPLOAD_MB=20
USER_STORAGE_QUOTA_MB=500

# -----------------------------------------------------------------------------
# 5. SMTP Mail Service (SendGrid / AWS SES / Resend)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_OR_SMTP_PASSWORD
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false
REQUIRE_EMAIL_VERIFICATION=false

# -----------------------------------------------------------------------------
# 6. AI Inference Configuration
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=https://ollama.your-gpu-host.com
OLLAMA_CHAT_MODEL=smartstudy-tutor
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TIMEOUT=120

