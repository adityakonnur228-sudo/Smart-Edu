# =============================================================================
# SMART STUDY PORTAL (SMART EDU) - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this template to .env.production on your production server.
# Ensure strict file permissions: chmod 600 .env.production
# NEVER commit credentials or tokens to source control!

# -----------------------------------------------------------------------------
# 1. Relational Database (MySQL 8.4 Enterprise / Production)
# -----------------------------------------------------------------------------
MYSQL_DATABASE=smart_study
MYSQL_USER=smart_study_prod
MYSQL_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE_MIN_24_CHARS
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD_HERE_MIN_32_CHARS
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# 2. Spring Boot 3.4 API Gateway (Port 8080)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/smart_study?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=smart_study_prod
SPRING_DATASOURCE_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE_MIN_24_CHARS

# Security & Session Authentication
JWT_SECRET=GENERATE_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_64_HEX_CHARS
JWT_TTL_MINUTES=60
COOKIE_SECURE=true
WEB_ORIGIN=https://smartstudy.edu

# Storage & Quotas
UPLOAD_DIR=/data/uploads
APP_MAX_UPLOAD_MB=20
APP_USER_STORAGE_QUOTA_MB=500

# Inter-Service Authentication
ML_SERVICE_URL=http://ml:8000
ML_INTERNAL_TOKEN=GENERATE_SECURE_INTERNAL_CLUSTER_TOKEN_MIN_32_CHARS

# SMTP Production Mail Service
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=YOUR_SENDGRID_OR_AWS_SES_API_KEY
SPRING_MAIL_FROM=support@smartstudy.edu
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
APP_REQUIRE_EMAIL_VERIFICATION=true

# -----------------------------------------------------------------------------
# 3. FastAPI Python ML & Vector Service (Internal Port 8000)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=smartstudy-tutor
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CONTEXT_SIZE=8192
CHROMA_PERSIST_DIRECTORY=/app/chroma_data
OCR_ENABLED=true
OCR_LANGS=eng

# -----------------------------------------------------------------------------
# 4. Next.js 16 Production Frontend (Port 3000)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_URL=https://smartstudy.edu/api/v1
NEXT_PUBLIC_DEMO_MODE=false

