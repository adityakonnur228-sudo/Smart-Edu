# =============================================================================
# SMART STUDY PORTAL — ML SERVICE ENVIRONMENT VARIABLES (RAILWAY / PRODUCTION)
# =============================================================================
# Target Service: FastAPI Python ML & Vector Retrieval Engine
# Base Image: Python 3.12-slim
# =============================================================================

# Server Port (Injected automatically by Railway, default: 8000)
PORT=8000

# Inter-Service Authentication (Must match ML_INTERNAL_TOKEN in backend)
ML_INTERNAL_TOKEN=GENERATE_SECURE_INTERNAL_CLUSTER_TOKEN_MIN_32_CHARS

# -----------------------------------------------------------------------------
# 1. AI Inference Endpoint (GPU Host / RunPod / Modal / Dedicated VM)
# -----------------------------------------------------------------------------
# Remote secured Ollama base URL (e.g. https://ollama.your-gpu-host.com)
OLLAMA_BASE_URL=https://ollama.your-gpu-host.com

# Optional Bearer Token if Ollama is behind an authenticated proxy
# OLLAMA_API_KEY=YOUR_SECURE_OLLAMA_BEARER_TOKEN

# Model names
OLLAMA_CHAT_MODEL=smartstudy-tutor
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=15
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false

# -----------------------------------------------------------------------------
# 2. Vector Database Persistence (ChromaDB)
# -----------------------------------------------------------------------------
# Path to persistent directory (Mount a Railway Persistent Volume here!)
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_PERSIST_DIRECTORY=/data/chroma

# -----------------------------------------------------------------------------
# 3. Live Web Research (Tavily Search API)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-YOUR_TAVILY_API_KEY_HERE
TAVILY_DAILY_CREDIT_BUDGET=50
TAVILY_CACHE_TTL_MINUTES=360
TAVILY_MAX_STUDENT_DAILY_SEARCHES=20

# -----------------------------------------------------------------------------
# 4. Document Processing & OCR
# -----------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGS=eng
MAX_PAGES_PER_FILE=300

