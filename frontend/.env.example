# =============================================================================
# SMART STUDY PORTAL — FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Production Host: Vercel (Project Root: frontend/)
#
# IMPORTANT SECURITY RULES:
# - NEVER put secret API keys, database credentials, or private tokens here.
# - ANY variable with 'NEXT_PUBLIC_' is baked into public client-side JavaScript.
# =============================================================================

# Public REST API Base URL (Point to your Railway Spring Boot API domain)
# Examples:
#   Local Development:  http://localhost:8080/api/v1
#   Railway Production: https://api.yourdomain.com/api/v1 or https://smart-study-backend.up.railway.app/api/v1
NEXT_PUBLIC_API_BASE_URL=https://smart-study-backend.up.railway.app/api/v1

# Backward-compatibility alias (fallback if NEXT_PUBLIC_API_BASE_URL is omitted)
NEXT_PUBLIC_API_URL=https://smart-study-backend.up.railway.app/api/v1

# Demo Mode toggle: set to false in production
NEXT_PUBLIC_DEMO_MODE=false

